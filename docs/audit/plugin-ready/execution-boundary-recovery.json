  "source_and_output_review": [
    {
      "rule": "Provider-controlled verification receives no coordinator credential or injection environment; evidence, bounds and cleanup remain canonical.",
      "files": [
        "lib/execution_result.mjs",
        "lib/git.mjs",
        "lib/gh.mjs",
        "lib/prd.mjs",
        "lib/tick.mjs",
        "docs/execution.md"
      ],
      "boundaries_checked": [
        "The sole Verify launcher supplies an explicit basics allowlist and existing Git/npm tooling helpers to /bin/sh -c, retaining the approved command, owned cwd, 120-second timeout and 256 KiB bound.",
        "Tokens, arbitrary credential variables, proxy credentials, SSH agent state, NODE_OPTIONS and shell startup selectors are excluded; private HOME/XDG/temp/gh profiles replace personal configuration and repository Git helpers are reset.",
        "Native subprocesses see none of 15 injected environment keys; success returns exit 0 and failure exit 23 with exact evidence. Private profiles are removed after success, failure, dirty-tree rejection and concurrent cancellation.",
        "Published replay and blocked failure/interruption checkpoints cannot run commands again. Empty checks allocate no private profile and claim no test evidence.",
        "Environment separation does not add an OS sandbox. Existing host restrictions, execution consent, provider/model defaults and later native preparation qualification are unchanged."
      ],
      "regressions": [
        "verification uses a credential-free environment and removes private profiles on success and failure",
        "verification tracked writes block publication at the unchanged native Git head",
        "verification staged writes block publication at the unchanged native Git head",
        "verification untracked writes block publication at the unchanged native Git head",
        "cancellation during verification fences publication and retains verification evidence"
      ]
    },
    {
      "rule": "Only the coordinator resumes the durable local stop fallback, and only for the exact owned running job and validated surviving processes.",
      "files": [
        "lib/execution.mjs",
        "lib/run.mjs",
        "lib/control.mjs",
        "lib/tick.mjs",
        "test/run_stop.test.mjs",
        "docs/execution.md"
      ],
      "boundaries_checked": [
        "Reconciliation reuses requestRunCancellation and runner.kill after accepted run-ID matching; the runner honors the saved killAfter deadline rather than starting a new stop timer.",
        "Before the deadline no fallback signal is sent. Read-only current/inspect never signals, reused PIDs and unavailable process inspection remain pending with RUN_STOP_UNVERIFIED, and further dispatch stays fenced.",
        "A native cancellation owner exits before its timer fires. New coordinators recover attached and detached TERM-ignoring descendants from persisted process identities and confirm cancelled/137 only after shutdown.",
        "Settled local outcomes, unfinished completion snapshots, local timeout fence release, remote/preparation permanent stops and legacy active-run identities keep their existing lifecycle behavior."
      ],
      "regressions": [
        "coordinator reconciliation resumes an owned local kill fallback after restart without another control",
        "restarted coordinator recovers a lost kill timer for native tools (detached=false)",
        "restarted coordinator recovers a lost kill timer for native tools (detached=true)"
      ]
    },
    {
      "rule": "Reported remote sessions cannot replace recorded task/run/job/root ownership before observation, continuation, collection or publication.",
      "files": [
        "lib/execution_io.mjs",
        "lib/execution.mjs",
        "lib/execution_result.mjs",
        "docs/execution.md"
      ],
      "boundaries_checked": [
        "One session validator is used by acknowledgements, lookup/inspection, fresh and cached collection, and shared result publication. Missing/null reports retain ownership; a first nonempty report may establish an unrecorded session.",
        "Foreign, empty or nonstring reported identities are rejected before event journal writes, cost adoption, terminal settlement, result persistence or artifact mutation.",
        "A foreign continuation acknowledgement remains acceptance-unknown. Bad lookup cannot resolve it; correct lookup reconciles the same durable intent without another paid continuation.",
        "Job/root/input-head, authoritative terminal outcome, timestamps, allowance, bounded I/O/backoff and stopped-result quarantine still apply. Cancellation replies only acknowledge the exact requested root and never adopt a returned session."
      ],
      "regressions": [
        "openai-agents fixture: foreign sessions cannot enter observation, collection, cache or continuation ownership",
        "codex-cloud fixture: foreign sessions cannot enter observation, collection, cache or continuation ownership",
        "shared publication rejects foreign or malformed sessions before any artifact mutation"
      ]
    },
    {
      "rule": "History restores each missing rendered row using stable event and row identities, with bounded buffers and disconnect cleanup.",
      "files": [
        "templates/tracker/tracker.js",
        "test/tracker.test.mjs",
        "lib/tracker/stream.mjs",
        "lib/tracker/runs.mjs",
        "docs/execution.md"
      ],
      "boundaries_checked": [
        "Paint assigns row positions before heartbeat filtering. Normal rows, orphan heartbeat rows and history rows carry the same event/position identity.",
        "History deduplicates at row granularity, preserves surviving siblings and pending events, and merges missing rows by event then row position without losing tool/heartbeat state.",
        "Numeric and sparse replay IDs restore the missing first row of a partially evicted three-row event in its original order; overlapping pages retain one orphan heartbeat row.",
        "The 400-event pending cap, 2000-row live tail, bounded loaded history, scroll correction, pagination, retention gaps, failed fetch recovery and pagehide cancellation remain covered."
      ],
      "regressions": [
        "partially evicted multi-row events restore missing rows in order (firstId=1)",
        "partially evicted multi-row events restore missing rows in order (firstId=10)",
        "orphan heartbeat rows retain their identity across overlapping recovery pages"
      ]
