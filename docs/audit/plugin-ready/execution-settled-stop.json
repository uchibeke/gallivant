  "source_and_output_review": [
    {
      "rule": "A task cancellation fences future dispatch without rewriting an already collected local run; live writers still require exact shutdown confirmation and quarantine.",
      "files": [
        "lib/execution.mjs",
        "lib/run.mjs",
        "lib/control.mjs",
        "lib/tick.mjs",
        "lib/commands/resume.mjs",
        "lib/task_prepare.mjs",
        "docs/execution.md"
      ],
      "boundaries_checked": [
        "collected local success/failure is preserved before process control and capability rejection",
        "restart reconciliation cannot reclassify a completed local root as cancelled or exit 137",
        "immediate cancel preserves the job file; later observations may advance liveness timestamps without changing historical exit, end time, session or cost",
        "Codex-shaped and Claude-shaped offline fixtures retain saved result bytes, operation metadata and allowance through repeated cancel and restart",
        "completed legacy jobs retain files and session without a synthetic stop/adoption record or submission intent",
        "operator control and coordinator ticks preserve registry last-run evidence and prevent corrective resume after task cancellation",
        "native Node fixture processes retain exact exits 0 and 23 and cached outcomes after diagnostic and public log removal",
        "future submit, continuation and result collection remain fenced; read-only outcome still exposes the exact historical result",
        "active legacy/local cancellation, uncertain process ownership, detached-tool shutdown and unsupported controls retain existing confirmation rules",
        "local implementation timeout release, permanent preparation/remote stop fences and collected remote result quarantine retain their existing behavior",
        "provider/model defaults, sandbox permissions, preparation authority and state schema are unchanged"
      ],
      "regressions": [
        "cancelling settled local outcomes preserves success, failure, cost and session across restart",
        "completed legacy local jobs keep their files and identity when future dispatch is cancelled",
        "operator cancellation leaves settled local registry evidence unchanged through coordinator ticks",
        "native completed local roots retain exact exits and results after cancel and log retention"
      ],
