  "source_and_output_review": [
    {
      "rule": "Runtime allowance uses authoritative owned completion rather than operator resume or durable retrieval time; result collection precedes terminal settlement.",
      "files": [
        "lib/execution.mjs",
        "lib/task_prepare.mjs",
        "lib/tasks.mjs",
        "lib/tick.mjs"
      ],
      "boundaries_checked": [
        "exact job/root/input ownership before accepting observation or result timestamps",
        "nullable completion timestamp and conservative first terminal observation upper bound",
        "pre-start, nonterminal, invalid, conflicting and tampered cached completion values cannot authorize readiness",
        "terminal success and failure with missing results stay pending after a deadline",
        "late results preserve usage and cost but cannot authorize readiness or another turn",
        "cached collection replays original completion after restart and older metadata",
        "local process completion remains compatible; coordinator retrieval time stays separate"
      ],
      "regressions": [
        "remote preparation uses owned completion time before a late resume, including missing results and inferred bounds",
        "invalid or conflicting remote completion timestamps cannot authorize preparation readiness or rewrite cached results"
      ]
    },
    {
      "rule": "An unconfirmed preparation stop remains reconcilable while dispatch stays fenced; cancellation requested is distinct from confirmed or natural terminal completion.",
      "files": [
        "lib/task_prepare.mjs",
        "lib/tasks.mjs",
        "lib/execution.mjs",
        "lib/control.mjs",
        "lib/commands/task.mjs"
      ],
      "boundaries_checked": [
        "attempt stop intent persisted before control I/O",
        "pending and lost acknowledgements retain preparing state and explicit owned cancellation next action",
        "existing boundary cadence, exact identity and cancellation idempotency key handle retries",
        "unknown acceptance resolves ownership before the provider stop",
        "unsupported cancellation permits only reconciliation or externally confirmed terminal completion",
        "unsafe boundary stop cannot qualify output",
        "older blocked timeouts permit explicit control-only resume while other blocked refusals remain inert",
        "inspect/list remain read-only with no provider loop",
        "confirmed or terminal stops settle blocked, quarantine late output and prevent new dispatch"
      ],
      "regressions": [
        "timed-out intake stop remains resumable across acknowledgement loss, unknown ownership, unsupported cancel and legacy blocking"
      ]
    },
    {
      "rule": "Reject an entire oversized raw local record without projecting a later suffix; stable gaps and bounded replay survive restart and retention.",
      "files": [
        "lib/run.mjs",
        "lib/execution.mjs",
        "lib/execution_journal.mjs",
        "lib/tracker/stream.mjs",
        "lib/tracker/runs.mjs"
      ],
      "boundaries_checked": [
        "persistent discard-through-newline across bounded current and queued pages",
        "active EOF retains discard state until delimiter or confirmed process exit",
        "final unterminated oversized record is discarded through EOF",
        "one-byte legacy cursor lookbehind fits inside each raw read budget",
        "restart and cursor acknowledgement loss retain stable event identities without duplicate history",
        "next valid Unicode record and unrelated current output remain observable",
        "invalid discard metadata refuses dispatch before paid intent and preserves diagnostic state",
        "private suffixes never enter journal/public log",
        "expiry emits one stable gap while cached results remain intact",
        "read/buffer/record limits are asserted without wall-clock thresholds"
      ],
      "regressions": [
        "oversized local records discard every suffix across queued restart, replay and legacy cursors with bounded reads",
        "an active oversized local record stays discarded at EOF until its newline arrives",
        "oversized discard retention emits a stable history gap while keeping the completed result",
        "incompatible local projection state prevents paid intent and preserves ownership and allowance"
      ]
    }
  ],
