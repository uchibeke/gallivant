{
  "name": "gallivant",
  "version": "0.1.0",
  "description": "Write a PRD, mark it ready, go outside. Keeps coding-agent pull requests moving through review and CI without you.",
  "type": "module",
  "bin": { "gallivant": "bin/gallivant.mjs" },
  "exports": { ".": "./lib/tasks.mjs", "./tasks": "./lib/tasks.mjs", "./context": "./lib/context.mjs", "./lib/*": "./lib/*", "./package.json": "./package.json" },
  "files": ["bin", "lib", "templates", "README.md", "LICENSE", "docs/*.md"],
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:task-intake": "node --test test/task-intake.test.mjs",
    "test:live-harnesses": "node test/live-harnesses.mjs",
    "lint": "node --check bin/gallivant.mjs && for f in lib/*.mjs lib/*/*.mjs; do node --check \"$f\" || exit 1; done"
  },
  "keywords": ["claude-code", "codex", "pull-request", "autonomous", "agent", "aport"],
  "license": "Apache-2.0",
  "repository": { "type": "git", "url": "https://github.com/uchibeke/gallivant.git" }
}
